CURRENCY=INR
JWT_SECRET=any_long_random_text

# Admin panel login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/prescripto

# Cloudinary (required for image upload)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Payments (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# AI report assistant (optional, free key from aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=